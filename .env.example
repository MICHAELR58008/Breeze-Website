# Required
DATABASE_URL=postgresql://user:password@localhost:5432/breeze_cleaning
BLOB_READ_WRITE_TOKEN=

# Optional (defaults to local-dev mode)
NEXT_PUBLIC_TINA_CLIENT_ID=local-dev
TINA_TOKEN=local-dev-token

# Notifications
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
NOTIFICATION_EMAIL=

# Airtable (admin dashboard replacement)
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Bookings

# Admin Authentication — cookie-based (never prefix with NEXT_PUBLIC_)
ADMIN_PASSWORD=your-admin-password
ADMIN_SECRET=your-admin-secret
ADMIN_API_KEY=
